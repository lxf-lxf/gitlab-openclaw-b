# 服务
PORT=3000
NODE_ENV=development

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gitlab_b_center

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# 逻辑库编号 0-15；多环境/重置库后建议用独立 db（如 1）避免残留队列
REDIS_DB=0
REDIS_KEY_PREFIX=bcenter:

# GitLab
GITLAB_BASE_URL=https://gitlab.com/api/v4

# Webhook 回调根地址（GitLab 能访问到的地址，不含路径）
WEBHOOK_BASE_URL=http://127.0.0.1:3000

# OpenClaw（Windows 示例：C:\Users\<用户>\AppData\Roaming\npm\openclaw.cmd）
OPENCLAW_BIN=openclaw
# 留空则使用 $HOME/.openclaw/agents
OPENCLAW_AGENTS_DIR=
OPENCLAW_DEFAULT_WORKSPACE=/path/to/workspace
OPENCLAW_DEFAULT_MODEL=deepseek/deepseek-v4-flash
# Windows CLI 冷启动慢时可加大（毫秒），默认 Windows 30s
# OPENCLAW_CLI_TIMEOUT_MS=60000

# Agent 执行日志目录（留空则用系统临时目录/gitlab-b-center/agent-logs，Windows 勿用 /tmp）
# BCENTER_AGENT_LOG_DIR=C:\logs\bcenter

# 首次配置向导完成后自动设为 1
BCENTER_SETUP_DONE=0

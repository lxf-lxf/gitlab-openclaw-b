{
  "id": "gitlab-tools",
  "name": "GitLab Tools",
  "description": "GitLab Issue/MR 工具集 - Issue 查询/更新/评论、MR 查询/评论/合并/审批、状态标签管理",
  "version": "1.0.0",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "gitlabToken": {
        "type": "string",
        "description": "GitLab Personal Access Token"
      },
      "gitlabBaseUrl": {
        "type": "string",
        "description": "GitLab 实例基础 URL（必填，如 https://gitlab.com/api/v4）"
      },
      "defaultProjectId": {
        "type": "string",
        "description": "默认项目 ID（可选）"
      }
    },
    "additionalProperties": false
  },
  "contracts": {
    "tools": [
      "gitlab_issue_get",
      "gitlab_issue_update",
      "gitlab_issue_comment",
      "gitlab_mr_list",
      "gitlab_mr_get",
      "gitlab_add_label",
      "gitlab_set_state_label",
      "gitlab_flow_state",
      "gitlab_project_info",
      "gitlab_mr_comment",
      "gitlab_mr_update",
      "gitlab_mr_merge",
      "gitlab_mr_approve",
      "gitlab_mr_add_label"
    ]
  }
}
